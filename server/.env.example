# انسخ إلى .env وعدّل القيم (لا ترفع .env إلى git)
PORT=3000
# تطوير مع Vite: المنفذ 5173. تشغيل Docker أو خادم واحد يخدم الواجهة: نفس منفذ الخادم (مثلاً 3000)
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=ضع_هنا_سلسلة_عشوائية_طويلة_للإنتاج
# اختياري: مجلد dist للواجهة بعد البناء — يفعّل خدمة SPA من Express (انظر README / Docker)
# CLIENT_DIST=C:\path\to\ayman-chat\client\dist
# USE_SQLITE=1
# SQLITE_PATH=./data/ayman.sqljs.db
#
# WebRTC — مصفوفة JSON لـ RTCIceServer[] (STUN/TURN). انظر deploy/docker-compose.coturn.example.yml
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
